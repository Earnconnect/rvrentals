# Copy to .env and fill in. .env is loaded automatically when the server starts.
# On Vercel, set these in Project → Settings → Environment Variables instead.
PORT=3000
BASE_URL=https://staycamp.online

# Database. Leave empty to use the local file data/riseflorals.db.
# Required on Vercel: a Turso database (https://turso.tech), e.g. libsql://staycamp-yourname.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Time zone used for "today" (check-in dates, dashboards). Defaults to America/New_York on Vercel.
APP_TIMEZONE=America/New_York

# Email (https://resend.com): API key and a sender on a domain verified in Resend
RESEND_API_KEY=
MAIL_FROM=bookings@staycamp.online

# Optional: online card payments
STRIPE_SECRET_KEY=
